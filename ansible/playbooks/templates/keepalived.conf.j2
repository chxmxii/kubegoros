# {{ ansible_managed }}
global_defs {
    enable_script_security
    script_user root
}

vrrp_script apiserver_health_check {
    script "/etc/keepalived/heartbeat.sh"
    interval 3
    timeout 10
    fall 5
    rise 2
    weight -2
}

vrrp_instance VI_1 {
    state BACKUP
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}
    priority {{ 101 - groups['haproxylb'].index(inventory_hostname) }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ vip_address }}
    }
    track_script {
        apiserver_health_check
    }
}
