#!/bin/sh
# {{ ansible_managed }}
# keepalived health check: the local HAProxy must answer on the API port.
errorExit() {
  echo "*** $*" 1>&2
  exit 1
}

if ip addr | grep -q "{{ vip_address }}"; then
  curl --silent --max-time 2 --insecure "https://{{ vip_address }}:6443/readyz" -o /dev/null \
    || errorExit "Error GET https://{{ vip_address }}:6443/readyz"
fi
pidof haproxy >/dev/null || errorExit "haproxy is not running"
