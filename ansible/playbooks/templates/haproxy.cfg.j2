# {{ ansible_managed }}
global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon
    stats socket /var/lib/haproxy/stats mode 600 level admin
    # utilize system-wide crypto-policies
    ssl-default-bind-ciphers PROFILE=SYSTEM
    ssl-default-server-ciphers PROFILE=SYSTEM

defaults
    log                     global
    option                  dontlognull
    option                  redispatch
    retries                 3
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout check           10s
    maxconn                 3000

{% if haproxy_metrics_isenabled | bool %}
#--------------------------------------------------------------
# Prometheus metrics only (no stats page exposed)
#--------------------------------------------------------------
frontend metrics
    mode http
    bind *:8404
    http-request use-service prometheus-exporter if { path /metrics }
    http-request deny
{% endif %}
#--------------------------------------------------------------
# Kubernetes API servers
#--------------------------------------------------------------
frontend k8s-controlplane
    bind {{ vip_address }}:6443
    mode tcp
    option tcplog
    default_backend k8s-controlplane-backend

backend k8s-controlplane-backend
    mode tcp
    balance roundrobin
    # /readyz is reachable anonymously (kube_anonymous_paths in roles/kubeadm)
    option httpchk GET /readyz
    http-check expect status 200
    default-server inter 5s fall 3 rise 2 check check-ssl verify none
{% for host in groups['kube_controlplanes'] %}
    server {{ host }} {{ hostvars[host]['ansible_default_ipv4']['address'] }}:6443
{% endfor %}
