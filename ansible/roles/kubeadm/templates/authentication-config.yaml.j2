# {{ ansible_managed }}
apiVersion: apiserver.config.k8s.io/v1
kind: AuthenticationConfiguration
jwt:
  - issuer:
      url: {{ kube_oidc_issuer_url }}
{% if kube_oidc_issuer_ca | length > 0 %}
      certificateAuthority: |
        {{ kube_oidc_issuer_ca | indent(8) }}
{% endif %}
      audiences:
{% for aud in kube_oidc_audiences %}
        - {{ aud }}
{% endfor %}
      audienceMatchPolicy: MatchAny
    claimMappings:
      username:
        claim: {{ kube_oidc_username_claim }}
        prefix: "{{ kube_oidc_username_prefix }}"
      groups:
        claim: {{ kube_oidc_groups_claim }}
        prefix: "{{ kube_oidc_groups_prefix }}"
anonymous:
  enabled: true
  conditions:
{% for path in kube_anonymous_paths %}
    - path: {{ path }}
{% endfor %}
