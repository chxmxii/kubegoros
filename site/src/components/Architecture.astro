---
// Architecture of the cluster. Colors come from Starlight's theme variables,
// so the diagram follows light/dark mode.
---
<figure class="kg-arch">
  <div class="kg-arch-scroll" tabindex="0" role="region" aria-label="Architecture diagram, scrollable">
  <svg viewBox="0 0 760 470" role="img" aria-labelledby="kg-arch-title kg-arch-desc">
    <title id="kg-arch-title">kubegoros architecture</title>
    <desc id="kg-arch-desc">Users reach the cluster over the LAN or a NetBird tunnel. Envoy Gateway terminates TLS on a MetalLB address and checks Keycloak sessions. ArgoCD syncs every app from GitHub. Three control planes sit behind an HAProxy and keepalived VIP; three workers run the workloads on Cilium and Longhorn.</desc>
    <defs>
      <marker id="kg-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 8 4 0 8Z" class="kg-fill-line" />
      </marker>
    </defs>

    <!-- band labels -->
    <text x="12" y="62" class="kg-band">ACCESS</text>
    <text x="12" y="202" class="kg-band">PLATFORM</text>
    <text x="12" y="372" class="kg-band">NODES</text>

    <!-- access -->
    <rect x="96" y="30" width="118" height="54" class="kg-box" />
    <text x="155" y="54" class="kg-t">You</text>
    <text x="155" y="72" class="kg-s">browser, kubectl</text>

    <rect x="252" y="30" width="138" height="54" class="kg-box" />
    <text x="321" y="54" class="kg-t">LAN or NetBird</text>
    <text x="321" y="72" class="kg-s">WireGuard</text>

    <rect x="428" y="30" width="160" height="54" class="kg-box kg-accent" />
    <text x="508" y="54" class="kg-t">Envoy Gateway</text>
    <text x="508" y="72" class="kg-s">10.254.100.205</text>

    <rect x="626" y="30" width="118" height="54" class="kg-box" />
    <text x="685" y="54" class="kg-t">Keycloak</text>
    <text x="685" y="72" class="kg-s">realm kubegoros</text>

    <line x1="214" y1="57" x2="250" y2="57" class="kg-line" marker-end="url(#kg-arrow)" />
    <line x1="390" y1="57" x2="426" y2="57" class="kg-line" marker-end="url(#kg-arrow)" />
    <line x1="588" y1="57" x2="624" y2="57" class="kg-line kg-dash" marker-end="url(#kg-arrow)" />

    <!-- platform -->
    <rect x="96" y="140" width="648" height="124" class="kg-zone" />
    <rect x="112" y="156" width="140" height="92" class="kg-box kg-accent" />
    <text x="182" y="186" class="kg-t">ArgoCD</text>
    <text x="182" y="206" class="kg-s">app of apps</text>
    <text x="182" y="224" class="kg-s">syncs from git</text>

    <rect x="268" y="156" width="148" height="42" class="kg-box" />
    <text x="342" y="182" class="kg-t">Prometheus, Grafana</text>
    <rect x="268" y="206" width="148" height="42" class="kg-box" />
    <text x="342" y="232" class="kg-t">Loki, Vector</text>

    <rect x="432" y="156" width="148" height="42" class="kg-box" />
    <text x="506" y="182" class="kg-t">Longhorn, CNPG</text>
    <rect x="432" y="206" width="148" height="42" class="kg-box" />
    <text x="506" y="232" class="kg-t">Headlamp, Hubble</text>

    <rect x="596" y="156" width="132" height="92" class="kg-box" />
    <text x="662" y="186" class="kg-t">External Secrets</text>
    <text x="662" y="206" class="kg-s">reads Vault</text>
    <text x="662" y="224" class="kg-s">10.254.100.107</text>

    <line x1="508" y1="84" x2="508" y2="138" class="kg-line" marker-end="url(#kg-arrow)" />
    <text x="516" y="116" class="kg-s kg-left">TLS, SSO, routes</text>

    <!-- nodes -->
    <rect x="96" y="300" width="648" height="150" class="kg-zone" />
    <rect x="112" y="316" width="148" height="56" class="kg-box" />
    <text x="186" y="340" class="kg-t">HAProxy + keepalived</text>
    <text x="186" y="358" class="kg-s">API VIP 10.254.100.99</text>

    <rect x="280" y="316" width="140" height="56" class="kg-box" />
    <text x="350" y="340" class="kg-t">3 control planes</text>
    <text x="350" y="358" class="kg-s">kubeadm 1.37, etcd</text>

    <rect x="440" y="316" width="140" height="56" class="kg-box" />
    <text x="510" y="340" class="kg-t">3 workers</text>
    <text x="510" y="358" class="kg-s">containerd 2.x</text>

    <rect x="600" y="316" width="128" height="56" class="kg-box" />
    <text x="664" y="340" class="kg-t">Proxmox VMs</text>
    <text x="664" y="358" class="kg-s">EL8 / EL9</text>

    <line x1="260" y1="344" x2="278" y2="344" class="kg-line" marker-end="url(#kg-arrow)" />

    <rect x="112" y="388" width="616" height="46" class="kg-band-box" />
    <text x="420" y="416" class="kg-t">Cilium (eBPF, no kube-proxy) and Longhorn replicas on every worker</text>

    <line x1="420" y1="264" x2="420" y2="298" class="kg-line" marker-end="url(#kg-arrow)" />
  </svg>
  </div>
  <figcaption>Request path on top, the GitOps layer in the middle, the machines at the bottom. Dashed: login redirect.</figcaption>
</figure>

<style>
  .kg-arch { margin: 0; }
  .kg-arch-scroll { overflow-x: auto; }
  .kg-arch svg { width: 100%; min-width: 620px; height: auto; display: block; }
  .kg-arch figcaption { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); margin-top: .5rem; }
  .kg-box { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-4); stroke-width: 1; rx: 6; }
  .kg-accent { stroke: var(--sl-color-accent); stroke-width: 1.5; }
  .kg-zone { fill: none; stroke: var(--sl-color-gray-5); stroke-dasharray: 4 4; rx: 6; }
  .kg-band-box { fill: var(--sl-color-accent-low); stroke: none; rx: 6; }
  .kg-line { stroke: var(--sl-color-gray-3); stroke-width: 1.4; fill: none; }
  .kg-dash { stroke-dasharray: 4 3; }
  .kg-fill-line { fill: var(--sl-color-gray-3); }
  .kg-t { fill: var(--sl-color-white); font: 500 13px var(--sl-font); text-anchor: middle; }
  .kg-s { fill: var(--sl-color-gray-3); font: 400 11px var(--sl-font-mono); text-anchor: middle; }
  .kg-left { text-anchor: start; }
  .kg-band { fill: var(--sl-color-gray-3); font: 500 10px var(--sl-font-mono); letter-spacing: .08em; }
</style>
